# ═══════════════════════════════════════════════════════════════
# Server environment template — copy to server/.env and fill in.
# NEVER commit the real server/.env (it is gitignored).
# ═══════════════════════════════════════════════════════════════

# ── Supabase (required) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Auth (required) ────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string

# ── Google OAuth (required for Google sign-in) ─────────────────
# From Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM providers ──────────────────────────────────────────────
# Groq (required) — Llama 4 Scout/Maverick — console.groq.com/keys
GROQ_API_KEY=
# Google AI / Gemini (required for resume edit/tailor) — aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral / Codestral (optional — only used by code_gen) — console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ── Optional integrations ──────────────────────────────────────
# Tavily web search — app.tavily.com
TAVILY_API_KEY=
JSEARCH_API_KEY=

# ── Server ─────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Feature flags (default OFF — see src/config/featureFlags.ts) ─
USE_LANGGRAPH=false
USE_QDRANT_RAG=false
USE_LANGFUSE=false
USE_HYBRID_JOB_RANKING=false
